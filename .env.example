# Copy to .env.local for local development. For GitHub Pages, set these as
# repository VARIABLES (Settings > Secrets and variables > Actions > Variables).
#
# Every VITE_* value is compiled into the public website. Never put a secret here:
# no spreadsheet ids, API keys, service-role keys or passwords.

# Apps Script web app URL. Must end in /exec. See integrations/google-sheets/README.md
VITE_SUBMISSION_ENDPOINT=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shown in the footer and on the Help Us Improve page
VITE_CONTACT_EMAIL=fac-contact@example.org

# Shown in the Privacy Policy and on the consent step. Falls back to VITE_CONTACT_EMAIL
VITE_PRIVACY_CONTACT_EMAIL=fac-privacy@example.org

# Optional: path the site is served from. Defaults to /friendship-match-quest-game/
# VITE_BASE_PATH=/friendship-match-quest-game/

# Optional: origin used for social preview links
# SITE_ORIGIN=https://tasmiahjh-hash.github.io
